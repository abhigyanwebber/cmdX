{
  "name": "pulse",
  "type": "spinner",
  "version": "1.0.0",
  "author": "abhigyanwebber",
  "description": "Pulsing circle spinner",
  "render": {
    "mode": "sixel",
    "width": 24,
    "height": 12,
    "color_mode": "truecolor",
    "symbol_set": "block",
    "dither": false,
    "stretch": false,
    "threshold": 0.3
  },
  "spinner": {
    "frames": [
      "frame1.png",
      "frame2.png",
      "frame3.png",
      "frame4.png",
      "frame5.png",
      "frame6.png",
      "frame7.png",
      "frame8.png"
    ],
    "interval_ms": 80,
    "reverse": false,
    "bounce": false,
    "loop": true,
    "on_complete": "checkmark"
  }
}
