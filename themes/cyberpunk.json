{
  "meta": {
    "name": "cyberpunk",
    "version": "1.0.0",
    "author": "abhigyanwebber",
    "description": "Neon soaked cyberpunk terminal"
  },
  "colors": {
    "primary": "#FF6600",
    "secondary": "#00FFFF",
    "background": "#0D0D0D",
    "foreground": "#FFFFFF",
    "accent": "#FFD700",
    "error": "#FF4444",
    "success": "#00FF88",
    "warning": "#FFA500",
    "muted": "#444444"
  },
  "prompt": {
    "symbol": "▶",
    "separator": "⟩",
    "style": "multiline",
    "segments": [
      "user",
      "directory",
      "git",
      "time"
    ],
    "format": "{user} @ {dir} {git}\n{symbol} "
  },
  "loader": {
    "frames": [
      "◐",
      "◓",
      "◑",
      "◒"
    ],
    "interval_ms": 100,
    "color": "primary"
  },
  "progress_bar": {
    "filled": "▓",
    "empty": "░",
    "width": 50,
    "color": "primary"
  },
  "cursor": {
    "style": "block",
    "blink": true,
    "color": "accent"
  },
  "borders": {
    "style": "sharp",
    "chars": {
      "top_left": "┌",
      "top_right": "┐",
      "bottom_left": "└",
      "bottom_right": "┘",
      "horizontal": "─",
      "vertical": "│"
    }
  },
  "banner": {
    "enabled": true,
    "text": "SYSTEM ONLINE // {user}",
    "style": "figlet",
    "color": "primary"
  },
  "graphics": {
    "gradient": {
      "enabled": true,
      "from": "#FF00FF",
      "to": "#00FFFF",
      "direction": "horizontal"
    },
    "divider": {
      "style": "zigzag",
      "color": "#FF00FF"
    },
    "effects": {
      "banner": "glitch",
      "prompt": "none"
    },
    "icons": {
      "enabled": true,
      "directory": "󰉋",
      "git_branch": "",
      "error": "",
      "success": "",
      "time": ""
    }
  }
}